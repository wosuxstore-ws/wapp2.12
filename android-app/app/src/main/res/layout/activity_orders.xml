<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <!-- ============ Header: back / title / more ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/backButton"
            style="@style/HeaderCircleButton"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/home_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Orders"
            android:textColor="@color/home_title"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_medium" />

        <ImageView
            android:id="@+id/moreButton"
            style="@style/HeaderCircleButton"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_more"
            android:contentDescription="More"
            app:tint="@color/home_title" />
    </FrameLayout>

    <!-- ============ Search ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:importantForAccessibility="no"
            app:tint="@color/home_nav_inactive" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="Search orders"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/home_title"
            android:textColorHint="@color/home_nav_inactive"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ============ Status chips ============ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="10dp">

            <TextView
                style="@style/OrdersChip"
                android:background="@drawable/bg_chip_selected"
                android:tag="all"
                android:text="All" />
            <TextView
                style="@style/OrdersChip"
                android:tag="placed"
                android:text="Placed" />
            <TextView
                style="@style/OrdersChip"
                android:tag="processing"
                android:text="Processing" />
            <TextView
                style="@style/OrdersChip"
                android:tag="preparing"
                android:text="Preparing" />
            <TextView
                style="@style/OrdersChip"
                android:tag="shipped"
                android:text="Shipped" />
            <TextView
                style="@style/OrdersChip"
                android:tag="delivered"
                android:text="Delivered" />
            <TextView
                style="@style/OrdersChip"
                android:tag="cancelled"
                android:text="Cancelled" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ============ Orders list ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ordersRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="8dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No orders yet"
            android:textColor="@color/home_nav_inactive"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>
